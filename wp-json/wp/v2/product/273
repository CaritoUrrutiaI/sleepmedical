l rendimiento<\/li>\n<li>Sistema de gesti\u00f3n de pacientes Encore:<\/li>\n<li>Informes de cumplimiento, datos y formas de onda<\/li>\n<li>Memoria integrada<\/li>\n<li>M\u00f3dulo de oximetria (opcional)<\/li>\n<li>Varias soluciones de supervisi\u00f3n remota apoy\u00e1ndose en la tecnolog\u00eda bluetooth y la red m\u00f3vil o Wi-Fi opcionales<\/li>\n<\/ul>\n","protected":false},"excerpt":{"rendered":"<p>&nbsp;<\/p>\n[contact-form to=\"contacto@sleepmedical.cl\" subject=\"Cotizaci\u00f3n AutoBiPAP\"][contact-field label=\"Nombre\" type=\"name\" required=\"1\"][contact-field label=\"Correo electr\u00f3nico\" type=\"email\" required=\"1\"][contact-field label=\"Tel\u00e9fono\" type=\"text\" required=\"1\"][contact-field label=\"Mensaje\" type=\"textarea\"][\/contact-form]\n","protected":false},"featured_media":276,"comment_status":"open","ping_status":"closed","template":"","meta":{"pagelayer_contact_templates":[],"_pagelayer_content":""},"product_brand":[25],"product_cat":[23],"product_tag":[22],"class_list":["post-273","product","type-product","status-publish","has-post-thumbnail","product_brand-philips-respironics","product_cat-bipap","product_tag-autobipap-dreamstation","first","instock","shipping-taxable","product-type-simple"],"jetpack_sharing_enabled":true,"_links":{"self":[{"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/product\/273","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/product"}],"about":[{"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/types\/product"}],"replies":[{"embeddable":true,"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/comments?post=273"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/media\/276"}],"wp:attachment":[{"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/media?parent=273"}],"wp:term":[{"taxonomy":"product_brand","embeddable":true,"href":"https:\/\/www.sleepmedical.cl\/wp-json\/wp\/v2\/pro